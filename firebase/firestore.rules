rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    match /Users/{uid} {
      allow read, update, delete: if owns(uid);
      allow create: if owns(uid) && request.resource.data.keys().hasOnly(['createdAt', 'role', 'premium', 'providers']);
    }

    match /Profiles/{uid} {
      allow read: if true;
      allow create, update: if owns(uid) && request.resource.data.username is string;
      allow delete: if owns(uid);
    }

    match /Settings/{uid}/{document=**} { allow read, write: if owns(uid); }
    match /Favorites/{uid}/{document=**} { allow read, write: if owns(uid); }
    match /History/{uid}/{document=**} { allow read, write: if owns(uid); }
    match /Notifications/{uid}/{document=**} { allow read, update, delete: if owns(uid); allow create: if false; }
    match /Achievements/{uid}/{document=**} { allow read: if owns(uid); allow write: if false; }

    match /Tools/{toolId} { allow read: if true; allow write: if false; }
    match /Comments/{commentId} { allow read: if true; allow create: if verified(); allow update, delete: if false; }
    match /Reports/{reportId} { allow create: if signedIn(); allow read, update, delete: if false; }
    match /Stats/{document=**} { allow read: if true; allow write: if false; }
    match /Admin/{document=**} { allow read, write: if false; }
    match /Logs/{document=**} { allow read, write: if false; }
  }
}
